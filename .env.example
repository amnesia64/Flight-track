# ── Flight APIs ────────────────────────────────────────────────────────────────
# RapidAPI key — get it free at https://rapidapi.com
RAPIDAPI_KEY=

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=

# 2. Message @userinfobot on Telegram → it replies with your Chat ID
TELEGRAM_CHAT_ID=

# ── Cron job defaults ──────────────────────────────────────────────────────────
# How many days from today to search for departure (default: 30)
DEFAULT_DEPART_DAYS=30

# How many days the trip lasts (default: 7)
DEFAULT_TRIP_DAYS=7
