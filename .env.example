# Claude AI — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# RapidAPI key — get it at https://rapidapi.com (one key works for all RapidAPI services)
RAPIDAPI_KEY=

# Skyscanner API host on RapidAPI (default shown — change if you subscribed to a different variant)
SKYSCANNER_API_HOST=sky-scanner3.p.rapidapi.com

# Optional: your second flight booking API host on RapidAPI
# Examples: booking-com15.p.rapidapi.com | priceline-com-provider.p.rapidapi.com
FLIGHT_BOOKING_API_HOST=
